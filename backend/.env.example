NODE_ENV=development
PORT=3000

# Exact browser origins allowed to call the API; comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost

# --- Supabase PostgreSQL Database ---
# Paste your Supabase connection string below (Dashboard -> Project Settings -> Database -> Connection string)
# Recommended: Transaction pooler (port 6543) or Session pooler / Direct (port 5432)
# Format: postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- Supabase Project Credentials (Server-side) ---
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Security / JWT Secrets ---
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-for-access-tokens
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-for-refresh-tokens

# --- Google Gemini AI Assistant ---
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# --- Background Worker & Queue (Optional) ---
# If Redis is running, supply the connection URL. If omitted, the server runs without Redis workers.
REDIS_URL=
AUTO_CLOSE_DAYS=14

